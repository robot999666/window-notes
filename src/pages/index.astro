---
import BaseLayout from '../layouts/BaseLayout.astro';
import Garden from '../components/Garden.astro';
import { profile, projects, notes } from '../data/site';

const featuredNotes = notes;
const featuredProjects = projects.slice(0, 6);
const formatDate = (date: string) => date.split('T')[0].replaceAll('-', '.');
---
<BaseLayout>
  <header class="site-header">
    <div class="header-inner wrap">
      <a class="brand" href="/" aria-label="窗边手记首页">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 30 30" fill="none"><path d="M8 21C5 12 11 6 23 6c1 12-5 18-15 15Z" fill="currentColor"/><path d="m7 25 12-14m-8 9-1-6m5 2h5" stroke="var(--paper)" stroke-width="1.5" stroke-linecap="round"/></svg>
        </span>
        <span>窗边手记<span class="brand-subtitle">ROBOT'S LITTLE GARDEN</span></span>
      </a>
      <nav class="main-nav" aria-label="主导航">
        <a href="#notes" class="nav-active">手记</a>
        <a href="#projects">项目</a>
        <a href="#about">关于</a>
      </nav>
      <div class="header-tools">
        <button class="icon-button search-trigger" type="button" data-search-open aria-label="搜索手记" aria-haspopup="dialog">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg>
          <span>搜索</span><kbd>/</kbd>
        </button>
        <span class="tool-divider" aria-hidden="true"></span>
        <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="切换明暗主题" title="切换明暗主题">
          <svg class="moon-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.7 13.4A8.8 8.8 0 0 1 10.6 3.3 8.8 8.8 0 1 0 20.7 13.4Z"/></svg>
          <svg class="sun-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main id="main-content" class="wrap">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="tiny-leaf" aria-hidden="true"></span> 欢迎来到我的数字花园</p>
        <h1 id="hero-title">慢慢写代码，<br />也慢慢<span class="warm-underline">记录生活。</span></h1>
        <p class="hero-description">你好，我是 <a href={profile.url} target="_blank" rel="noopener noreferrer">{profile.login}</a>。<br />在代码与好奇心之间，留一个安静的小角落，<br class="desktop-break" />收集学习的片段，也让每一个想法慢慢生长。</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#notes">翻开手记 <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5"/></svg></a>
          <a class="button button-quiet" href="#about">认识一下 <span aria-hidden="true">↗</span></a>
        </div>
        <p class="hero-footnote"><span aria-hidden="true">✳</span> 一点代码，一点思考，一点日常。</p>
      </div>
      <Garden />
    </section>

    <div class="section-divider"><span>KEEP LEARNING, KEEP GROWING</span><svg viewBox="0 0 32 24" fill="none" aria-hidden="true"><path d="M15 20c-1-7 0-11 5-17m-6 11C7 14 4 11 4 6c6 0 10 3 10 8Zm3-4c7 2 11-1 12-6-6-2-10 0-12 6Z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></div>

    <section class="notes-section" id="notes" aria-labelledby="notes-title">
      <div class="content-grid">
        <div class="notes-main">
          <div class="section-heading">
            <div><p class="section-kicker">THE NOTEBOOK</p><h2 id="notes-title">最近的手记<span class="heading-dot">.</span></h2></div>
            <div class="section-links"><a class="text-link" href="/notes/">全部手记 <span aria-hidden="true">↗</span></a><a class="text-link" href="/rss.xml" title="订阅 RSS" aria-label="通过 RSS 订阅更新"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="3" cy="13" r="1" fill="currentColor" stroke="none"/><path d="M2 7a7 7 0 0 1 7 7M2 2a12 12 0 0 1 12 12"/></svg></a></div>
          </div>
          <div class="note-filters" aria-label="按分类筛选手记">
            <button type="button" class="filter-button active" data-filter="all" aria-pressed="true">全部手记</button>
            <button type="button" class="filter-button" data-filter="工程实践" aria-pressed="false">工程实践</button>
            <button type="button" class="filter-button" data-filter="AI 与研究" aria-pressed="false">AI 与研究</button>
            <button type="button" class="filter-button" data-filter="学习记录" aria-pressed="false">学习记录</button>
          </div>
          <div class="notes-list" id="notes-list">
            {featuredNotes.map((note) => (
              <article class="note-card" data-note data-category={note.category}>
                <div class="note-meta"><span class:list={['category-label', { 'category-ai': note.category === 'AI 与研究', 'category-learning': note.category === '学习记录' }]}><span class="category-dot" aria-hidden="true"></span>{note.category}</span><time datetime={note.date}>{formatDate(note.date)}</time></div>
                <a class="note-link" href={`/notes/${note.slug}/`}>
                  <h3>{note.title}</h3>
                  <p>{note.description}</p>
                  <span class="note-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></span>
                </a>
                <div class="note-bottom"><div class="note-tags">{note.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}</div><span class="reading-time"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="5.5"/><path d="M8 4.5V8l2 1.5"/></svg>{note.readingTime}阅读</span></div>
              </article>
            ))}
          </div>
          <p class="notes-source"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 3h6a2 2 0 0 1 2 2v8H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/><path d="M6 3v10m3-6h2m-2 3h2"/></svg> 这本手记，从公开项目的整理与回顾开始。</p>
        </div>

        <aside class="sidebar" aria-label="博主与小站介绍">
          <div class="profile-card">
            <div class="profile-cover" aria-hidden="true"><span class="cover-sun"></span><span class="cover-hill hill-back"></span><span class="cover-hill hill-front"></span><svg viewBox="0 0 50 70" fill="none"><path d="M25 69V17m0 19C6 36 0 27 4 17c14 0 21 7 21 19Zm0-11C40 26 50 18 46 8c-13-1-21 7-21 17Zm0 26C9 50 0 42 3 34c13-2 22 6 22 17Z" stroke="currentColor" stroke-width="2" fill="currentColor"/></svg></div>
            <div class="profile-content">
              <a href={profile.url} target="_blank" rel="noopener noreferrer" class="avatar-link" aria-label={`${profile.login} 的 GitHub 主页`}><img class="profile-avatar" src={profile.avatarUrl} alt={`${profile.login} 的 GitHub 头像`} width="64" height="64" loading="lazy" /></a>
              <p class="profile-greeting">HEY, I'M</p>
              <h3>{profile.login}<span class="profile-wave" aria-hidden="true">☀</span></h3>
              <p class="profile-bio">{profile.bio || '首都师范大学计算机科学与技术'}</p>
              <div class="profile-rule"></div>
              <p class="profile-note">保持好奇，认真做事。<br />愿每一份小小的积累，<br />都能长成自己的风景。</p>
              <a class="github-profile-link" href={profile.url} target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 19c-4 .8-4-2-6-2m14 5v-4a3.5 3.5 0 0 0-1-2.7c3.3-.4 6.7-1.6 6.7-7.3a5.6 5.6 0 0 0-1.5-3.9 5.2 5.2 0 0 0-.1-3.8s-1.3-.4-4.1 1.5a14.2 14.2 0 0 0-7.4 0C6.8-.1 5.5.3 5.5.3a5.2 5.2 0 0 0-.1 3.8 5.6 5.6 0 0 0-1.5 3.9c0 5.7 3.4 6.9 6.7 7.3A3.5 3.5 0 0 0 9.6 18v4" transform="translate(1.6 2) scale(.86)"/></svg>在 GitHub 上找到我 <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <div class="garden-note">
            <span class="quote-mark" aria-hidden="true">“</span>
            <p>不必急着成为一片森林，<br />先照顾好眼前的一株小苗。</p>
            <span class="quote-caption">A NOTE TO MYSELF</span>
            <svg class="quote-sprout" viewBox="0 0 40 45" fill="none" aria-hidden="true"><path d="M20 40V22m0 7C8 29 3 22 5 14c10 0 16 5 15 15Zm0-7C31 23 37 17 35 9c-10-1-16 4-15 13Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </div>
          <a class="sidebar-subscribe" href="/rss.xml"><span class="subscribe-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 9a11 11 0 0 1 11 11M4 3a17 17 0 0 1 17 17"/><circle cx="5" cy="19" r="1.5" fill="currentColor" stroke="none"/></svg></span><span><strong>偶尔来坐坐</strong><small>通过 RSS，订阅新的手记</small></span><span class="subscribe-arrow" aria-hidden="true">↗</span></a>
        </aside>
      </div>
    </section>

    <section class="projects-section" id="projects" aria-labelledby="projects-title">
      <div class="section-heading">
        <div><p class="section-kicker">THINGS I'M BUILDING</p><h2 id="projects-title">折腾过的小项目<span class="heading-dot">.</span></h2><p class="section-description">把好奇心写成代码，把一些想法变成可以打开的东西。</p></div>
        <a class="text-link" href={`${profile.url}?tab=repositories`} target="_blank" rel="noopener noreferrer">所有公开仓库 <span aria-hidden="true">↗</span></a>
      </div>
      <div class="project-grid">
        {featuredProjects.map((project, index) => (
          <a class="project-card" href={project.url} target="_blank" rel="noopener noreferrer">
            <div class="project-top"><span class:list={['project-icon', `project-icon-${index % 3}`]} aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d={index % 3 === 0 ? 'm8 6-6 6 6 6m8-12 6 6-6 6m-3-15-2 18' : index % 3 === 1 ? 'M12 3 3 8l9 5 9-5-9-5Zm-9 9 9 5 9-5M3 16l9 5 9-5' : 'M4 4h6a2 2 0 0 1 2 2v15a4 4 0 0 0-4-2H4V4Zm16 0h-6a2 2 0 0 0-2 2v15a4 4 0 0 1 4-2h4V4Z'}/></svg></span><svg class="external-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M6 4h10v10M16 4 4 16"/></svg></div>
            <h3>{project.displayName || project.name}</h3>
            <span class="project-repo-name">{project.name}</span>
            <p>{project.description || '一个仍在探索中的公开项目。打开仓库，看看代码与实践。'}</p>
            <div class="project-footer"><span class="project-language"><span class:list={['language-dot', `language-${(project.language || 'other').toLowerCase().replaceAll(' ', '-')}`]} aria-hidden="true"></span>{project.language || '探索与实践'}</span>{project.fork ? <span class="project-kind">Fork 项目</span> : <span class="project-kind">公开仓库</span>}</div>
          </a>
        ))}
      </div>
    </section>

    <section class="about-section" id="about" aria-labelledby="about-title">
      <div class="about-decoration" aria-hidden="true"><svg viewBox="0 0 100 120" fill="none"><path d="M51 109V45m0 40C22 85 8 66 14 47c24-2 40 13 37 38Zm0-23c29 2 44-16 38-35-23-2-41 12-38 35Zm0-17C33 42 25 29 31 14c19 4 26 17 20 31Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M25 112h52" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></div>
      <div class="about-copy"><p class="section-kicker">A LITTLE ABOUT THIS SPACE</p><h2 id="about-title">给想法一个落脚的地方。</h2><p>我是 {profile.login}，欢迎来到我的小小数字花园。<br />这里从 GitHub 上的公开项目开始，整理做过的尝试与学习线索。<br />愿这扇小窗，能留住探索时的一点光。</p><a href={profile.url} target="_blank" rel="noopener noreferrer" class="text-link">查看我的公开资料 <span aria-hidden="true">↗</span></a></div>
      <span class="about-handwritten" aria-hidden="true">nice to meet you :)</span>
    </section>
  </main>

  <footer class="site-footer wrap">
    <div class="footer-top"><a class="footer-brand" href="/">窗边手记<span aria-hidden="true">✳</span></a><p>在平凡的日子里，种下一点好奇心。</p><div class="footer-links"><a href={profile.url} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a><a href="/rss.xml">RSS <span aria-hidden="true">↗</span></a><a href="#main-content">回到顶部 <span aria-hidden="true">↑</span></a></div></div>
    <div class="footer-bottom"><span>© {new Date().getFullYear()} {profile.login}</span><span>用心记录 · 慢慢生长</span></div>
  </footer>

  <dialog id="search-dialog" class="search-dialog" aria-labelledby="search-title">
    <div class="search-dialog-header"><h2 id="search-title">找一篇手记</h2><button type="button" class="icon-button" data-search-close aria-label="关闭搜索"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"/></svg></button></div>
    <label class="search-field" for="search-input"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg><input id="search-input" type="search" placeholder="搜索标题、内容或标签…" autocomplete="off" /></label>
    <div id="search-results" class="search-results" aria-live="polite"></div>
    <div class="search-dialog-footer"><span>公开项目里的学习与探索</span><span><kbd>ESC</kbd> 关闭</span></div>
  </dialog>
</BaseLayout>
